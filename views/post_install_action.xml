<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <data noupdate="1">
            <record id="yourent_configurator_redirect" model="ir.actions.client">
                    <field name="name">YourRentConfigurator</field>
                    <field name="tag">yourent_configurator</field>
<!--                <field name="target">fullscreen</field>-->


             </record>
            <record id="yourent_configurator_url" model="ir.actions.act_url">
                    <field name="name">YourRentConfiguratorUrl</field>
                    <field name="url">/yourent/configurator</field>
                    <field name="target">self</field>
            </record>
            <record id="base.user_admin" model="res.users">
                <field name="action_id" ref="yourent_configurator_url"/>
            </record>

             <record model="ir.config_parameter" id="yourent_configurator_done">
                <field name="key">yourent_configurator.yourent_configurator_done</field>
                <field name="value">False</field>
            </record>
     </data>

</odoo>













